{
  "name": "aws",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"tsx watch server/index.ts\" \"vite\"",
    "server": "tsx watch server/index.ts",
    "client": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-server/server.mjs",
    "build:lambda": "esbuild server/lambda.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist-server/index.mjs '--banner:js=import { createRequire } from \"module\"; const require = createRequire(import.meta.url);' '--external:@aws-sdk/*'",
    "start": "node dist-server/server.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1147.0",
    "@aws-sdk/client-bedrock": "^3.1147.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1147.0",
    "@aws-sdk/client-glue": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-sagemaker": "^3.1147.0",
    "@codegenie/serverless-express": "^5.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^6.30.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
