# WasteSignal AWS & Server Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL CREDENTIALS.

PORT=3001
AWS_REGION=ap-southeast-2
AWS_PROFILE=krishna
AWS_S3_BUCKET=wastesignal-data-YOUR_ACCOUNT_ID-YOUR_REGION
GLUE_DATABASE=wastesignal_db
ATHENA_DATABASE=wastesignal_db
ATHENA_OUTPUT_LOCATION=s3://wastesignal-data-YOUR_ACCOUNT_ID-YOUR_REGION/wastesignal/athena-results/
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
SAGEMAKER_ENDPOINT_NAME=

# Optional: Static credentials (prefer IAM roles or AWS named profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
